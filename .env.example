# =============================================================================
#  运行模式
# =============================================================================
# 默认 mock：各章使用脚本化的 mock handler，零配置即可运行，不产生任何网络请求。
# 只有设为 real（或使用命令行 --real）时才会请求真实模型。
AGENT_MODE=mock

# =============================================================================
#  真实模型（默认为 DeepSeek）
# =============================================================================
# 复制此文件为 .env 后填写 token 即可：
#   cp .env.example .env
#   npm run s01 -- --real        # 单章 real 模式
#   npm run harness:real         # 工程层 harness（真实工具 + 真实模型）
#
# 注意：.env 已被 .gitignore 忽略，切勿把 key 写进代码或提交到仓库。

# DeepSeek 的 Anthropic 兼容端点（官方文档：Using the Anthropic API）
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic

# DeepSeek API Key，二选一即可（AUTH_TOKEN 优先）
# 获取地址：https://platform.deepseek.com/api_keys
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_API_KEY=

# 模型 ID：deepseek-chat（日常编码，经济）| deepseek-reasoner（强推理）
MODEL_ID=deepseek-chat

# 单次响应的最大 token 数
MODEL_MAX_TOKENS=1024

# 备用模型：s11 错误恢复在连续 529 过载后切换到它（可选；不填则持续重试）
# FALLBACK_MODEL_ID=deepseek-reasoner

# 请求超时（毫秒），可选
# MODEL_TIMEOUT_MS=60000

# =============================================================================
#  评测裁判（可选）
# =============================================================================
# 默认复用 MODEL_ID；建议换一个模型，降低「裁判偏爱自己家族」的偏差。
# JUDGE_MODEL_ID=deepseek-reasoner
# 裁判单次输出的最大 token 数
# JUDGE_MAX_TOKENS=512

# =============================================================================
#  其他 Anthropic 兼容 provider（可选）
# =============================================================================
# 只要改 ANTHROPIC_BASE_URL + MODEL_ID 即可切换：
#   GLM (Zhipu)     https://open.bigmodel.cn/api/anthropic        MODEL_ID=glm-4.5
#   Kimi (Moonshot) https://api.moonshot.cn/anthropic             MODEL_ID=kimi-k2-0711-preview
#   Anthropic       https://api.anthropic.com                     MODEL_ID=claude-sonnet-4-6
